# Copy this file to .env and fill secrets locally. Never commit real secrets.

APP_TIME_ZONE=America/Toronto
CUSTOM_EMBROIDERY_MAX_UPLOAD_BYTES=10485760
CUSTOM_EMBROIDERY_ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_rotated_cloudflare_api_token
CLOUDFLARE_AI_MODEL=@cf/black-forest-labs/flux-2-klein-4b

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_DELIVERY_TYPE=authenticated

CUSTOM_EMBROIDERY_HMAC_SECRET=generate_a_long_random_secret

# Stripe guest checkout. Use sk_test_ and whsec_ values while developing.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STOREFRONT_URL=http://localhost:5173
CHECKOUT_FREE_SHIPPING_THRESHOLD_CENTS=10000
CHECKOUT_STANDARD_SHIPPING_CENTS=1500
# Leave false until the business is registered and Stripe Tax is configured.
CHECKOUT_AUTOMATIC_TAX_ENABLED=false

# Customer confirmation + Thread & Butter admin email notifications.
# Custom embroidery submission is email-only for now; keep SMS disabled.
THREAD_AND_BUTTER_ADMIN_EMAIL=you@example.com
THREAD_AND_BUTTER_ADMIN_PHONE=+14165551234

EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM_ADDRESS=orders@your-domain.example
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password_or_app_password
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true

# Passwordless email-code authentication. Generate both secrets independently,
# for example with: openssl rand -base64 48
AUTH_EMAIL_ENABLED=true
AUTH_OTP_PEPPER=replace_with_a_long_random_secret
AUTH_JWT_SECRET=replace_with_a_different_long_random_secret
AUTH_JWT_ISSUER=https://auth.thread-and-butter.invalid
AUTH_JWT_AUDIENCE=thread-and-butter-web
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_OTP_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_REQUEST_COOLDOWN_SECONDS=60
AUTH_EMAIL_LIMIT_PER_15_MINUTES=5
AUTH_IP_LIMIT_PER_HOUR=30
# false for http://localhost; true when the production site uses HTTPS.
AUTH_SECURE_COOKIES=false

SMS_NOTIFICATIONS_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+14165551234
