# Safe template for exercising the production topology on a developer machine.
DEPLOY_ENV_FILE=local.env

BACKEND_IMAGE=threadandbutter-backend:local
FRONTEND_IMAGE=threadandbutter-frontend:local
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

POSTGRES_DB=threadandbutter
POSTGRES_USER=threadandbutter
POSTGRES_PASSWORD=local_only_database_password_change_me

VITE_CLOUDINARY_CLOUD_NAME=replace_with_your_public_cloudinary_cloud_name
APP_TIME_ZONE=America/Toronto
STOREFRONT_URL=http://localhost:8080

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
CHECKOUT_FREE_SHIPPING_THRESHOLD_CENTS=10000
CHECKOUT_STANDARD_SHIPPING_CENTS=1500
CHECKOUT_AUTOMATIC_TAX_ENABLED=false

AUTH_OTP_PEPPER=local_only_otp_pepper_at_least_32_characters
AUTH_JWT_SECRET=local_only_jwt_secret_at_least_32_characters
CUSTOM_EMBROIDERY_HMAC_SECRET=local_only_hmac_secret_at_least_32_characters
AUTH_JWT_ISSUER=http://localhost:8080
AUTH_JWT_AUDIENCE=thread-and-butter-web
AUTH_SECURE_COOKIES=false
AUTH_EMAIL_ENABLED=false

PUBLIC_CONTACT_LIMIT=5
PUBLIC_CONTACT_WINDOW_SECONDS=900
PUBLIC_REQUEST_LIMIT=5
PUBLIC_REQUEST_WINDOW_SECONDS=3600
PUBLIC_PREVIEW_LIMIT=10
PUBLIC_PREVIEW_WINDOW_SECONDS=3600

EMAIL_NOTIFICATIONS_ENABLED=false
THREAD_AND_BUTTER_ADMIN_EMAIL=local@example.com
EMAIL_FROM_ADDRESS=local@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLED=false
SMTP_STARTTLS_REQUIRED=false

CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
CLOUDINARY_DELIVERY_TYPE=authenticated
CLOUDFLARE_ACCOUNT_ID=replace_me
CLOUDFLARE_API_TOKEN=replace_me
CLOUDFLARE_AI_MODEL=@cf/black-forest-labs/flux-2-klein-4b
SMS_NOTIFICATIONS_ENABLED=false
