# Copy this file to deploy/production.env. The real file is ignored by Git.
DEPLOY_ENV_FILE=production.env

# Immutable ECR image tags produced from the same Git commit.
BACKEND_IMAGE=000000000000.dkr.ecr.ca-central-1.amazonaws.com/threadandbutter-backend:replace_with_git_sha
FRONTEND_IMAGE=000000000000.dkr.ecr.ca-central-1.amazonaws.com/threadandbutter-frontend:replace_with_git_sha

# Caddy obtains and renews HTTPS certificates for this public DNS name.
SITE_ADDRESS=shop.example.com
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=threadandbutter
POSTGRES_USER=threadandbutter
POSTGRES_PASSWORD=replace_with_a_long_random_database_password

VITE_CLOUDINARY_CLOUD_NAME=replace_with_your_public_cloudinary_cloud_name

APP_TIME_ZONE=America/Toronto
STOREFRONT_URL=https://shop.example.com

# Keep Stripe in sandbox mode for the recruiter-facing portfolio deployment.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
CHECKOUT_FREE_SHIPPING_THRESHOLD_CENTS=10000
CHECKOUT_STANDARD_SHIPPING_CENTS=1500
CHECKOUT_AUTOMATIC_TAX_ENABLED=false

# Use three independently generated values: openssl rand -base64 48
AUTH_OTP_PEPPER=replace_with_a_long_random_otp_pepper
AUTH_JWT_SECRET=replace_with_a_different_long_random_jwt_secret
CUSTOM_EMBROIDERY_HMAC_SECRET=replace_with_a_third_long_random_hmac_secret
AUTH_JWT_ISSUER=https://shop.example.com
AUTH_JWT_AUDIENCE=thread-and-butter-web
AUTH_SECURE_COOKIES=true
AUTH_EMAIL_ENABLED=false

PUBLIC_CONTACT_LIMIT=5
PUBLIC_CONTACT_WINDOW_SECONDS=900
PUBLIC_REQUEST_LIMIT=5
PUBLIC_REQUEST_WINDOW_SECONDS=3600
PUBLIC_PREVIEW_LIMIT=10
PUBLIC_PREVIEW_WINDOW_SECONDS=3600

EMAIL_NOTIFICATIONS_ENABLED=false
THREAD_AND_BUTTER_ADMIN_EMAIL=replace_me@example.com
EMAIL_FROM_ADDRESS=replace_me@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_me
SMTP_PASSWORD=replace_me
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SMTP_STARTTLS_REQUIRED=true

CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
CLOUDINARY_DELIVERY_TYPE=authenticated

CLOUDFLARE_ACCOUNT_ID=replace_me
CLOUDFLARE_API_TOKEN=replace_me
CLOUDFLARE_AI_MODEL=@cf/black-forest-labs/flux-2-klein-4b

SMS_NOTIFICATIONS_ENABLED=false
